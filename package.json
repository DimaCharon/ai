{
  "name": "charon-code",
  "productName": "Charon Code",
  "version": "1.0.1",
  "description": "Charon Code — десктопный AI-проводник: Arena AI, dahl.global, OpenRouter (free). Локальная база данных, оверлей-маскот, доступ к файлам и терминалу.",
  "main": "main.js",
  "author": "Charon",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "dist:portable": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.charon.code",
    "productName": "Charon Code",
    "copyright": "© 2026 Charon",
    "publish": null,
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Charon Code",
      "deleteAppDataOnUninstall": false
    }
  }
}